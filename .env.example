GEMINI_API_KEY=

# Encrypts the API keys users save for their own AI provider (OpenAI, Anthropic, OpenRouter, Gemini).
# Any long random string, e.g. `openssl rand -hex 32`. Changing it makes saved keys unreadable.
KEY_ENCRYPTION_SECRET=
PORT=8787

# Postgres connection string. In production (Cloud Run + Cloud SQL) this comes from Secret Manager:
# postgres://USER:PASS@/charla?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgres://localhost:5432/charla

# Google OAuth client — create one at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
